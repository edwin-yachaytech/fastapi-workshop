                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPassword!\",\n  \"remember_me\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login - correct (remember_me = false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tokens returned (200)\", function () { pm.response.to.have.status(200); });",
                  "function decodeJwt(t) {",
                  "  let p = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (p.length % 4) p += '=';",
                  "  return JSON.parse(atob(p));",
                  "}",
                  "const b = pm.response.json();",
                  "pm.test('Has access_token, refresh_token and bearer type', function () {",
                  "  pm.expect(b.access_token).to.be.a('string');",
                  "  pm.expect(b.refresh_token).to.be.a('string');",
                  "  pm.expect(b.token_type).to.eql('bearer');",
                  "  pm.expect(b.expires_in).to.eql(900);",
                  "});",
                  "// Guardar tokens para las siguientes peticiones",
                  "pm.collectionVariables.set('access_token', b.access_token);",
                  "pm.collectionVariables.set('refresh_token', b.refresh_token);",
                  "pm.test('Remember Me = false -> refresh token lasts ~7 days', function () {",
                  "  const c = decodeJwt(b.refresh_token);",
                  "  pm.expect((c.exp - c.iat) / 86400).to.be.closeTo(7, 0.1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"remember_me\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login - remember_me = true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "function decodeJwt(t) {",
                  "  let p = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (p.length % 4) p += '=';",
                  "  return JSON.parse(atob(p));",
                  "}",
                  "const b = pm.response.json();",
                  "pm.test('Remember Me = true -> refresh token lasts ~30 days', function () {",
                  "  const c = decodeJwt(b.refresh_token);",
                  "  pm.expect((c.exp - c.iat) / 86400).to.be.closeTo(30, 0.1);",
                  "});",
                  "pm.test('Access token is still short-lived (15 min)', function () {",
                  "  const c = decodeJwt(b.access_token);",
                  "  pm.expect((c.exp - c.iat) / 60).to.eql(15);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"remember_me\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
