# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.
DATABASE_URL=mysql+pymysql://apiuser:CHANGE_ME@localhost/workshop
JWT_SECRET=replace-this-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REMEMBER_REFRESH_TOKEN_DAYS=30

